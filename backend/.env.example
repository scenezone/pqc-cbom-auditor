APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pqc_cbom_auditor
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=100
MAX_EXTRACTED_SIZE_MB=300
MAX_REPOSITORY_FILES=5000
MAX_FILE_SIZE_MB=2
MAX_SCAN_DURATION_SECONDS=600
MAX_ACTIVE_SCANS=3
SCAN_TEMP_DIRECTORY=./tmp/scans
SCAN_RETENTION_HOURS=24
REPORT_RETENTION_HOURS=168
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
MAX_CLONE_SIZE_MB=200
CLONE_TIMEOUT_SECONDS=120
CYCLONEDX_SCHEMA_PATH=./schemas/cyclonedx-1.7.schema.json
REPORT_STORAGE_DIRECTORY=./tmp/reports
LOG_LEVEL=INFO
